# .env.example
# Copier ce fichier en .env.local et remplir les valeurs

# ──────────────────────────────────────────────
# BASE DE DONNÉES
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/uwh_world"

# ──────────────────────────────────────────────
# NEXTAUTH
# ──────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-min-32-chars"

# Email du super administrateur (compte créé automatiquement)
SUPER_ADMIN_EMAIL="ton@email.com"

# ──────────────────────────────────────────────
# PROVIDERS OAUTH
# ──────────────────────────────────────────────

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ──────────────────────────────────────────────
# EMAIL (pour magic links)
# ──────────────────────────────────────────────
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="noreply@uwhworld.com"

# ──────────────────────────────────────────────
# APP
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
